# Copy to .env.local (never committed). Only read by the serverless function in api/.
# Leave ANTHROPIC_API_KEY empty to keep the app in mock mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Server: live mode also needs this explicit opt-in (a key alone keeps answering 503).
LIVE_ANALYST_ENABLED=

# Client: "mock" (default) or "live". Live only works where /api is served (vercel dev / Vercel).
VITE_AI_MODE=mock
